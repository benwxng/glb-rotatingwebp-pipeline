# Only required when uploading to Cloudflare R2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=rotating-artifacts-public
R2_PUBLIC_BASE_URL=https://assets.example.com

