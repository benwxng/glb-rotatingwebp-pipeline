# Required when uploading to Cloudflare R2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=artifacts

# Optional. Uploads still work without this value; publicUrl will be null.
# During development, this can be the bucket's Public Development URL:
# R2_PUBLIC_BASE_URL=https://<generated-subdomain>.r2.dev
# In production, replace it with the bucket's custom domain.
R2_PUBLIC_BASE_URL=

# Optional catalog registration. Set both values to register every successful
# R2 upload through the web app's authenticated, transactional ingest endpoint.
# Leave both blank to render/upload without changing the catalog.
CATALOG_API_BASE_URL=http://localhost:3000
CATALOG_INGEST_TOKEN=

# Required only when using --sketchfab-uid.
SKETCHFAB_API_TOKEN=

# Optional executable overrides.
# BLENDER_BIN=/Applications/Blender.app/Contents/MacOS/Blender
# IMG2WEBP_BIN=/opt/homebrew/bin/img2webp
# WEBPMUX_BIN=/opt/homebrew/bin/webpmux
