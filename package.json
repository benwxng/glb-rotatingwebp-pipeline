{
  "name": "rotating-artifacts-pipeline",
  "version": "0.1.0",
  "private": true,
  "description": "Render transparent animated WebP turntables from downloadable 3D models and publish them to Cloudflare R2.",
  "type": "module",
  "bin": {
    "artifact-preview": "./dist/cli.js"
  },
  "scripts": {
    "artifact:preview": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "check": "pnpm test && pnpm build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1126.0",
    "dotenv": "17.4.2",
    "unzipper": "0.12.5"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "@types/unzipper": "0.10.11",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
